<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.takagoto.repo-cleanup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Users/takagoto/.claude/skills/repo-cleanup/daily/run.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>3</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/takagoto/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/takagoto</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/takagoto/.claude/repo-cleanup/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/takagoto/.claude/repo-cleanup/launchd.log</string>
</dict>
</plist>
