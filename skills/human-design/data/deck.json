  "layout": [
    {"id": "product-first", "recipe": "The live product or a real working screen is the first thing on the page; copy sits beside or under it.", "tags": ["tools", "b2b", "developer", "api", "dashboard"]},
    {"id": "index-list", "recipe": "One plain statement, then a dense scannable list or index (no cards); each row links somewhere real.", "tags": ["editorial", "directory", "local", "events", "utilitarian", "calm"]},
    {"id": "split-sticky", "recipe": "A sticky left column holds the statement/navigation; the right column scrolls through the content.", "tags": ["docs", "b2b", "editorial", "api", "tools", "premium"]},
    {"id": "catalogue", "recipe": "Image-first grid of real items with plain captions and prices.", "tags": ["collectible", "fashion", "food", "shop", "consumer"], "requires": "photos"},
    {"id": "spec-sheet", "recipe": "The page reads like a datasheet: label-value tables, measurements, versions, limits.", "tags": ["hardware", "api", "developer", "technical", "finance", "tools"]},
    {"id": "data-hero", "recipe": "A real chart or table is the hero; the headline interprets it (sample data must be labelled as sample).", "tags": ["data", "finance", "science", "dashboard", "competitive"]},
    {"id": "letter", "recipe": "One narrow column in a personal voice, signed by a named person; images inline like a letter.", "tags": ["community", "local", "craft", "storytelling", "newsletter"], "requires": "signer"},
    {"id": "poster", "recipe": "Oversized type and one image per screen; the scroll is a sequence of posters.", "tags": ["events", "music", "launch", "culture", "bold"]},
    {"id": "timeline", "recipe": "Chronology is the organising axis (schedule, history, release log, season, a day by the clock).", "tags": ["events", "history", "competitive", "sporty", "museum", "tools"]},
    {"id": "map-spatial", "recipe": "Location is the organising axis; a real map or floor plan carries the page.", "tags": ["local", "travel", "events", "hospitality", "civic"]},
    {"id": "magazine-spread", "recipe": "Asymmetric grid with offset image/text blocks and pull quotes. Watch out: do not drift into broadsheet cosplay (hairlines + zero radius).", "tags": ["editorial", "culture", "fashion", "publishing"], "requires": "photos"},
    {"id": "ledger", "recipe": "Utility density: tables, filters and numbers first, no hero at all (Craigslist/Bloomberg energy).", "tags": ["tools", "data", "finance", "dashboard", "utilitarian", "competitive"]},
    {"id": "walkthrough", "recipe": "One real task shown step by step with real screenshots; only for genuine sequences.", "tags": ["education", "tools", "onboarding", "health"], "requires": "screens"},
    {"id": "playground", "recipe": "An interactive toy or configurator is the page; explanation is secondary.", "tags": ["gaming", "playful", "developer", "consumer", "collectible"], "clash": ["legal", "health"]}
