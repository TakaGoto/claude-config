    {"id": "ink-and-spot", "recipe": "Paper ground, one ink for text and rules, one spot colour used rarely (like two-colour print).", "tags": ["editorial", "quiet", "calm", "civic", "b2b", "premium"], "mode": "light"},
    {"id": "material-sampled", "recipe": "Sample 4-6 colours from a photo of a physical material in the subject's world (playmat felt, kraft, enamel, anodised metal, card stock). Name each after the material. The dealt hue is optional here.", "tags": ["craft", "local", "warm", "collectible", "hardware", "gaming"], "mode": "either"},
    {"id": "signage", "recipe": "Two flat high-contrast colours borrowed from the subject's real signage or uniforms (transit, league, store sign), plus black and white.", "tags": ["civic", "sporty", "events", "local", "signage", "competitive"], "mode": "light"},
    {"id": "riso-duotone", "recipe": "Two printing inks that overprint (multiply) into a third colour; everything else is paper.", "tags": ["culture", "music", "playful", "events", "zine"], "mode": "light", "clash": ["premium", "luxury", "finance", "legal"]},
    {"id": "colour-field", "recipe": "The whole page ground is one saturated brand colour; text in a dark or light ink of the same hue family.", "tags": ["bold", "consumer", "launch", "playful"], "mode": "light"},
    {"id": "deep-hue-dark", "recipe": "Dark mode on a deep hue (bottle green, navy, aubergine, petrol), never neutral #0B0B0B; 3-4 tones of that hue plus one light accent that is not acid green.", "tags": ["gaming", "luxury", "premium", "night", "music", "collectible"], "mode": "dark"},
    {"id": "neutral-plus-data", "recipe": "Neutral greys for the interface; colour only encodes data and status, with a fixed meaning per colour.", "tags": ["data", "dashboard", "finance", "tools", "b2b", "calm", "competitive"], "mode": "either"},
    {"id": "photographic", "recipe": "The interface is black, white and one grey; real photography supplies all the colour. The dealt hue is optional here.", "tags": ["food", "hospitality", "fashion", "travel", "local"], "mode": "light", "requires": "photos"},
    {"id": "subject-pastels", "recipe": "Three soft tints pulled from the subject (packaging, toys, produce) on white, with a near-black ink for text.", "tags": ["kids", "food", "playful", "health"], "mode": "light", "clash": ["premium", "finance", "legal"]},
    {"id": "monochrome-ramp", "recipe": "One hue in six steps from near-white to near-black; no second hue at all.", "tags": ["quiet", "calm", "luxury", "premium", "tools", "nordic"], "mode": "either"},
    {"id": "tension-pair", "recipe": "Two near-complementary saturated colours in deliberate tension, used in large blocks, never as gradient.", "tags": ["youth", "music", "sporty", "competitive", "gaming"], "mode": "either", "clash": ["calm", "luxury", "health"]},
